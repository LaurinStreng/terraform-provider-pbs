# Copy to testacc.env (git-ignored) and adjust for your test PBS.
# Defaults below match `docker compose up -d` from this repository.
#
# WARNING: acceptance tests create and DELETE real objects (datastores,
# jobs, notification targets, ...). Never point them at a production server.

# --- PBS connection (same variables the provider reads) ---
PBS_ENDPOINT=https://localhost:8007
PBS_USERNAME=admin@pbs
PBS_PASSWORD=pbspbs
# PBS_API_TOKEN=user@realm!tokenname:secret   # alternative to username/password
PBS_INSECURE=true

# Directory on the PBS host under which test datastores are created.
PBS_TEST_DATASTORE_ROOT=/datastore

# Remove datastore contents when a test datastore is destroyed.
PBS_DESTROY_DATA_ON_DELETE=true

# --- Helper services, as reachable FROM THE PBS SERVER ---
# With docker compose these are the service names on the compose network.
# With a PBS VM, use the IP of the machine running the helper containers.
PBS_TEST_INFLUXDB_HOST=influxdb
PBS_TEST_INFLUXDB_PORT=8086
PBS_TEST_INFLUXDB_ORG=testorg
PBS_TEST_INFLUXDB_BUCKET=pbs-metrics
PBS_TEST_INFLUXDB_TOKEN=test-token-for-pbs-provider
PBS_TEST_INFLUXDB_UDP_HOST=influxdb-udp
PBS_TEST_INFLUXDB_UDP_PORT=8089
PBS_TEST_GOTIFY_HOST=gotify
PBS_TEST_GOTIFY_PORT=80
PBS_TEST_WEBHOOK_HOST=webhook
PBS_TEST_WEBHOOK_PORT=8080

# --- Optional: S3 tests (tier heavy) are skipped unless set ---
# PBS_TEST_S3_ENDPOINT=s3.us-east-1.amazonaws.com
# PBS_TEST_S3_REGION=us-east-1
# PBS_TEST_S3_ACCESS_KEY=
# PBS_TEST_S3_SECRET_KEY=
# PBS_TEST_S3_BUCKET=
